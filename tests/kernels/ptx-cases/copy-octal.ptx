.version 7.0
.target sm_80
.address_size 64
.global .align 16 .u32 source[4] = {0x12345678, 0xabcdef01, 0x87654321, 0x10fedcba};
.visible .entry k(.param .u64 output) .reqntid 32,1,1 {
    .reg .b32 %lane, %dst, %r<4>;
    .reg .b64 %src, %out;
    .shared .align 16 .b8 rows[512];
    mov.u32 %lane, %laneid;
    mov.u32 %dst, rows;
    mad.lo.u32 %dst, %lane, 16, %dst;
    mov.u64 %src, source;
    // Octal 010 copies two words and zeroes the trailing two.
    cp.async.ca.shared.global [%dst], [%src], 16, 010;
    cp.async.wait_all;
    ld.shared.v4.b32 {%r0,%r1,%r2,%r3}, [%dst];
    ld.param.u64 %out, [output];
    mad.wide.u32 %out, %lane, 16, %out;
    st.global.v4.b32 [%out], {%r0,%r1,%r2,%r3};
    ret;
}
